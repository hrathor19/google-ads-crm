// ═══════════════════════════════════════════════════════════════════════════
// CRM layer — everything below is owned by google-ads-crm.
//
// The 28 models above are introspected from the Google Ads Intelligence schema
// and are owned by that project's Alembic migrations. This app READS them and
// writes only through the sync engine, which reproduces the same
// delete-window-then-insert contract. Every table added here carries a `crm_`
// prefix so ownership is obvious in psql and the two migration histories can
// never collide.
// ═══════════════════════════════════════════════════════════════════════════

/// The Ad Setup & Approval flow, step for step.
///
/// CHANGES_REQUESTED, APPROVED, IN_PROGRESS and READY are the earlier,
/// shorter pipeline. Postgres cannot drop an enum value that rows may still
/// reference, so they stay here but are unreachable: nothing in TRANSITIONS
/// moves to them, and the migration maps the rows that held them.
enum AdRequestStatus {
  DRAFT
  SUBMITTED
  AWAITING_AM_ASSIGNMENT
  AM_ASSIGNED
  AWAITING_AD_SUBMISSION
  ADS_SUBMITTED
  UNDER_REVIEW
  RECHECK_REQUESTED
  REVIEW_APPROVED
  BUDGET_APPROVED
  ACCOUNT_ASSIGNED
  LIVE
  COMPLETED
  REJECTED

  // Retired.
  CHANGES_REQUESTED
  APPROVED
  IN_PROGRESS
  READY
}

/// How one review round ended.
enum ReviewOutcome {
  APPROVED
  RECHECK_REQUESTED
}

/// Who a notification mail goes to, besides any fixed addresses.
enum CrmEmailAudience {
  /// Everyone holding a given permission, e.g. whoever can approve.
  ROLE
  /// The person who raised the request.
  REQUESTER
  /// The person the request is assigned to.
  ASSIGNEE
  /// Only the fixed To addresses configured on the route.
  FIXED
}

/// Email settings, one row. `id` is pinned so there can only ever be one.
model CrmEmailSetting {
  id Int @id @default(1)

  /// Master switch. Off means nothing is sent, whatever the routes say.
  enabled Boolean @default(false)

  fromName  String  @default("KollegeApply Ads CRM") @map("from_name")
  fromEmail String  @map("from_email")
  replyTo   String? @map("reply_to")

  /// Prefixed to every subject. `[AD-{{reference}}]` keeps a request's mails
  /// in one thread in most clients, and makes them searchable.
  subjectPrefix String? @default("[{{reference}}]") @map("subject_prefix")

  /// Applied to every mail on top of whatever each route adds.
  globalCc  String? @map("global_cc")
  globalBcc String? @map("global_bcc")

  /// Sends nothing to real people; every mail goes here instead. For trying
  /// the configuration out without mailing the whole team.
  testModeRecipient String? @map("test_mode_recipient")

  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedById String?  @map("updated_by_id")
  updatedBy   CrmUser? @relation("emailSettingUpdatedBy", fields: [updatedById], references: [id])

  @@map("crm_email_settings")
}

/// What to send, and to whom, for one workflow event.
model CrmEmailRoute {
  id    String              @id @default(cuid())
  event CrmNotificationType @unique

  enabled Boolean @default(true)

  audience           CrmEmailAudience @default(ROLE)
  /// Used when `audience` is ROLE: everyone holding this `MODULE:ACTION`.
  audiencePermission String?          @map("audience_permission")

  /// Comma-separated addresses, added to whoever `audience` resolves to.
  toEmails String? @map("to_emails")
  cc       String?
  bcc      String?

  /// Mustache-ish: {{reference}} {{title}} {{status}} {{actor}} {{link}}.
  subject String
  /// Optional lead paragraph above the standard body.
  intro   String?

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("crm_email_routes")
}

/// The brief's "Client/Generic/NonClient/Exam" column.
enum AdRequestClientType {
  CLIENT
  GENERIC
  NON_CLIENT
  EXAM
}

/// Whether the campaign targets everyone or is age-gated.
enum AdRequestAgeRestriction {
  OPEN
  AGE_18_24
}

enum CampaignObjective {
  LEAD_GENERATION
  WEBSITE_TRAFFIC
  BRAND_AWARENESS
  APP_PROMOTION
  SALES
  LOCAL_VISITS
}

enum AdRequestEventType {
  CREATED
  SUBMITTED
  APPROVED
  REJECTED
  CHANGES_REQUESTED
  RESUBMITTED
  ASSIGNED
  STATUS_CHANGED
  COMMENT
  AD_COPY_GENERATED
  LANDING_SCORED
  CAMPAIGN_LINKED
}

enum CrmNotificationType {
  REQUEST_SUBMITTED
  REQUEST_APPROVED
  REQUEST_REJECTED
  REQUEST_CHANGES_REQUESTED
  REQUEST_ASSIGNED
  REQUEST_COMMENTED
  REQUEST_STATUS_CHANGED
}

enum CrmAuditAction {
  LOGIN
  LOGIN_FAILED
  LOGOUT
  PASSWORD_CHANGED
  PASSWORD_RESET
  USER_CREATED
  USER_UPDATED
  USER_ACTIVATED
  USER_DEACTIVATED
  ROLE_CREATED
  ROLE_UPDATED
  ROLE_CLONED
  ROLE_DELETED
  PERMISSION_CHANGED
  ACCOUNT_SCOPE_CHANGED
  REQUEST_CREATED
  REQUEST_SUBMITTED
  REQUEST_APPROVED
  REQUEST_REJECTED
  REQUEST_CHANGES_REQUESTED
  REQUEST_STATUS_CHANGED
  AI_COPY_GENERATED
  LANDING_PAGE_SCORED
  DATA_EXPORTED
  SYNC_TRIGGERED
  INTEGRATION_TESTED
  EMAIL_SETTINGS_UPDATED
  EMAIL_TEST_SENT
  REQUEST_ACCOUNT_CHANGED
}

/// A role is a named bundle of permission toggles plus an account scope.
/// Seeded roles carry `is_system` and cannot be deleted; a role with users
/// assigned cannot be deleted either (enforced in the API).
model CrmRole {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String   @unique
  description  String?
  /// Seeded by prisma/seed.ts. Blocks deletion and renaming of the slug.
  isSystem     Boolean  @default(false) @map("is_system")
  /// Short-circuits every permission check to `true`, the way Counselling CRM
  /// treats SUPER_ADMIN. Exactly one seeded role carries it.
  isSuperAdmin Boolean  @default(false) @map("is_super_admin")
  /// When false, the role only sees the accounts listed in `accountScopes`.
  allAccounts  Boolean  @default(true) @map("all_accounts")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  permissions   CrmRolePermission[]
  accountScopes CrmRoleAccount[]
  users         CrmUser[]

  @@map("crm_roles")
}

/// One row per (role, feature). Mirrors Counselling CRM's `Permission` table:
/// a missing row falls back to the role's seeded default rather than to false.
model CrmRolePermission {
  id      String  @id @default(cuid())
  roleId  String  @map("role_id")
  /// `"<MODULE>:<ACTION>"` — see lib/rbac/features.ts.
  feature String
  allowed Boolean @default(false)

  role CrmRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, feature], map: "crm_role_permissions_role_feature")
  @@index([roleId])
  @@map("crm_role_permissions")
}

/// Account-level scoping for a role. Only consulted when `allAccounts = false`.
model CrmRoleAccount {
  roleId    String @map("role_id")
  accountId Int    @map("account_id")

  role    CrmRole  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  account accounts @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([roleId, accountId])
  @@index([accountId])
  @@map("crm_role_accounts")
}

model CrmUser {
  id                 String    @id @default(cuid())
  email              String    @unique
  name               String
  /// bcrypt hash — never a plaintext password, never returned by any API.
  password           String
  roleId             String    @map("role_id")
  isActive           Boolean   @default(true) @map("is_active")
  /// Set for the seeded admin and after any admin-driven reset; the dashboard
  /// redirects to /change-password until it clears.
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  /// Per-user override of the role's account scope. When false, the user sees
  /// only `accountScopes`; when true, the role's scope applies.
  allAccounts        Boolean   @default(true) @map("all_accounts")
  lastLoginAt        DateTime? @map("last_login_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  role          CrmRole          @relation(fields: [roleId], references: [id])
  accountScopes CrmUserAccount[]

  requestsCreated    CrmAdRequest[]       @relation("requestCreatedBy")
  requestsAssigned   CrmAdRequest[]       @relation("requestAssignedTo")
  events             CrmAdRequestEvent[]
  adCopyVersions     CrmAdCopyVersion[]
  landingScores      CrmLandingScore[]
  notifications      CrmNotification[]
  managedRequests    CrmAdRequest[]       @relation("requestAccountManager")
  specialistRequests CrmAdRequest[]       @relation("requestAdSpecialist")
  reviewsGiven       CrmAdRequestReview[] @relation("reviewBy")
  emailSettings      CrmEmailSetting[]    @relation("emailSettingUpdatedBy")
  auditLogs          CrmAuditLog[]

  @@index([roleId])
  @@map("crm_users")
}

/// Per-user account scope. Only consulted when the user's `allAccounts = false`.
model CrmUserAccount {
  userId    String @map("user_id")
  accountId Int    @map("account_id")

  user    CrmUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  account accounts @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([userId, accountId])
  @@index([accountId])
  @@map("crm_user_accounts")
}

/// The Ad Request: the unit of work that moves Operations → Manager → Ads team.
model CrmAdRequest {
  id        String @id @default(cuid())
  /// Human-facing sequential reference, e.g. `AR-0042`.
  reference String @unique

  status    AdRequestStatus   @default(DRAFT)
  objective CampaignObjective @default(LEAD_GENERATION)

  title     String
  /// The Google Ads account this request targets (accounts.id).
  accountId Int?   @map("account_id")

  productService String    @map("product_service")
  /// Nullable: no longer asked for on the Ops requirement form. Kept for the
  /// rows that have it and for the ad-copy generator, which uses it when set.
  targetAudience String?   @map("target_audience")
  location       String
  /// Nullable: the sheet leaves "Assigned Budget" blank at submission and Ops
  /// applies it at the budget stage of the flow.
  budget         Decimal?  @db.Decimal(14, 2)
  startDate      DateTime  @map("start_date") @db.Date
  endDate        DateTime? @map("end_date") @db.Date
  landingPageUrl String    @map("landing_page_url")
  usps           String?
  /// Free-text, one keyword per line — optional per the brief.
  keywords       String?
  notes          String?

  // ── Campaign activation requirement ───────────────────────────────────────
  // The fields Ops fills from the "Ads Campaign Activation Requirement Format"
  // sheet. All nullable: existing rows predate them, and several are filled at
  // later stages of the flow rather than at submission.

  /// "New Tracking ID" — the client's own reference, e.g. 13000047.
  trackingId     String?                  @map("tracking_id")
  clientType     AdRequestClientType?     @map("client_type")
  ageRestriction AdRequestAgeRestriction? @default(OPEN) @map("age_restriction")

  /// Free text: the sheet carries "-" as often as a number.
  targetAdmission      String? @map("target_admission")
  /// Free text: "End of February" is a valid answer in the sheet.
  applicationDeadline  String? @map("application_deadline")
  focusedMonths        String? @map("focused_months")
  performanceParameter String? @map("performance_parameter")
  reportingPanel       String? @map("reporting_panel")
  /// "Open / Hidden / OtherAccount / Domain".
  accountVisibility    String? @map("account_visibility")
  /// Pincodes or areas to exclude, as typed.
  blockedLocations     String? @map("blocked_locations")

  /// Numeric because the flow does arithmetic on them: CPL approval, lead
  /// pacing against the monthly targets below.
  requiredLeads     Int?     @map("required_leads")
  targetApplication Int?     @map("target_application")
  requiredCpl       Decimal? @map("required_cpl") @db.Decimal(14, 2)

  /// Six destination URLs, by platform. The scored landing page is derived
  /// from the first one present — see `primaryLandingUrl` in the schema module.
  adUrlKapplpDesktop   String? @map("ad_url_kapplp_desktop")
  adUrlKapplpMobile    String? @map("ad_url_kapplp_mobile")
  adUrlKapplpBing      String? @map("ad_url_kapplp_bing")
  adUrlClientlpDesktop String? @map("ad_url_clientlp_desktop")
  adUrlClientlpMobile  String? @map("ad_url_clientlp_mobile")
  adUrlClientlpBing    String? @map("ad_url_clientlp_bing")

  /// Filled by the Ads team once the campaign exists in Google Ads.
  linkedCampaignId String? @map("linked_campaign_id")

  /// Mandatory on REJECTED; also carries the Request-Changes comment.
  decisionReason String?   @map("decision_reason")
  submittedAt    DateTime? @map("submitted_at")
  decidedAt      DateTime? @map("decided_at")
  completedAt    DateTime? @map("completed_at")

  createdById  String  @map("created_by_id")
  /// Kept as the general "who owns this now" pointer the lists sort on.
  assignedToId String? @map("assigned_to_id")

  /// The flow has two distinct owners, assigned at different steps, so one
  /// field cannot hold both: the Account Manager at step 3, and the Ad
  /// Specialist who builds and launches, formally assigned at step 11.
  accountManagerId String? @map("account_manager_id")
  adSpecialistId   String? @map("ad_specialist_id")

  /// Optimistic lock. Every transition reads it and writes it back in the
  /// same UPDATE, so two people approving at once cannot both succeed —
  /// the second finds the row already moved on.
  version Int @default(0)

  /// Which review round the request is on. Increments each time the ads go
  /// back for a recheck, so round N stays readable.
  reviewRound Int @default(0) @map("review_round")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  createdBy      CrmUser   @relation("requestCreatedBy", fields: [createdById], references: [id])
  assignedTo     CrmUser?  @relation("requestAssignedTo", fields: [assignedToId], references: [id])
  accountManager CrmUser?  @relation("requestAccountManager", fields: [accountManagerId], references: [id])
  adSpecialist   CrmUser?  @relation("requestAdSpecialist", fields: [adSpecialistId], references: [id])
  account        accounts? @relation(fields: [accountId], references: [id])

  events         CrmAdRequestEvent[]
  leadTargets    CrmAdRequestLeadTarget[]
  reviewRounds   CrmAdRequestReview[]
  attachments    CrmAdRequestAttachment[]
  adCopyVersions CrmAdCopyVersion[]
  landingScores  CrmLandingScore[]
  notifications  CrmNotification[]

  @@index([status])
  @@index([accountId])
  @@index([createdById])
  @@index([assignedToId])
  @@index([createdAt])
  @@map("crm_ad_requests")
}

/// The timeline / activity feed under a request. Comments and transitions share
/// one table so the feed is a single ordered read.
/// One pass of the review loop (steps 6-8).
///
/// A row per round rather than overwriting, so the third recheck can still
/// show what was wrong on the first. `adCopyVersion` pins which draft the
/// remarks applied to.
model CrmAdRequestReview {
  id        String @id @default(cuid())
  requestId String @map("request_id")
  /// 1 for the first review, incrementing with each recheck.
  round     Int

  outcome    ReviewOutcome
  /// Mandatory when the outcome is RECHECK_REQUESTED — enforced in the
  /// service, because "fix it" with no remark wastes a round.
  remarks    String?
  reviewerId String        @map("reviewer_id")
  reviewedAt DateTime      @default(now()) @map("reviewed_at")

  /// The ad copy version these remarks were written against.
  adCopyVersionId String? @map("ad_copy_version_id")

  request  CrmAdRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  reviewer CrmUser      @relation("reviewBy", fields: [reviewerId], references: [id])

  @@unique([requestId, round])
  @@index([requestId])
  @@map("crm_ad_request_reviews")
}

/// The sheet's month-by-month lead plan (Sep26 = 5, Oct26 = 12, …).
///
/// A child table rather than JSON so the months can be aggregated, compared
/// against delivered leads, and edited one row at a time.
model CrmAdRequestLeadTarget {
  id        String   @id @default(cuid())
  requestId String   @map("request_id")
  /// First day of the month, so ordering and date maths work.
  month     DateTime @db.Date
  leads     Int

  request CrmAdRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, month])
  @@index([requestId])
  @@map("crm_ad_request_lead_targets")
}

model CrmAdRequestEvent {
  id         String             @id @default(cuid())
  requestId  String             @map("request_id")
  type       AdRequestEventType
  /// Human-readable summary rendered in the feed.
  message    String
  /// Transition endpoints, when the event is a status change.
  fromStatus AdRequestStatus?   @map("from_status")
  toStatus   AdRequestStatus?   @map("to_status")
  actorId    String?            @map("actor_id")
  createdAt  DateTime           @default(now()) @map("created_at")

  request CrmAdRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor   CrmUser?     @relation(fields: [actorId], references: [id])

  @@index([requestId, createdAt])
  @@map("crm_ad_request_events")
}

model CrmAdRequestAttachment {
  id         String   @id @default(cuid())
  requestId  String   @map("request_id")
  filename   String
  mimeType   String   @map("mime_type")
  sizeBytes  Int      @map("size_bytes")
  /// Path under ./storage — never a browser-reachable path.
  storageKey String   @map("storage_key")
  createdAt  DateTime @default(now()) @map("created_at")

  request CrmAdRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@map("crm_ad_request_attachments")
}

/// One saved generation of RSA copy. Multiple versions per request; at most one
/// carries `isFinal` (enforced in the service).
model CrmAdCopyVersion {
  id        String @id @default(cuid())
  requestId String @map("request_id")
  /// 1-based, per request.
  version   Int
  tone      String

  /// `{ text, characters }[]` — validated against the 30-character headline cap.
  headlines    Json
  /// `{ text, characters }[]` — validated against the 90-character cap.
  descriptions Json
  /// Validator output: character-limit failures, duplicate detection, coverage.
  validation   Json?
  /// "gemini" | "deterministic" — which engine produced this version.
  backend      String

  isFinal     Boolean  @default(false) @map("is_final")
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  request   CrmAdRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  createdBy CrmUser      @relation(fields: [createdById], references: [id])

  @@unique([requestId, version])
  @@index([requestId])
  @@map("crm_ad_copy_versions")
}

/// A landing-page score run. History is kept per request so the Ads team can
/// see whether a fix moved the number.
model CrmLandingScore {
  id        String  @id @default(cuid())
  requestId String? @map("request_id")
  url       String

  score     Int
  grade     String
  pageType  String @map("page_type")
  /// Weighted checks that passed, and the maximum available.
  passed    Int
  maxPoints Int    @map("max_points")

  /// `{ item, ok, weight, category }[]`
  checks      Json
  /// Per-category sub-scores: Content / Tracking / Links.
  categories  Json
  /// Ordered improvement suggestions, heaviest lever first.
  suggestions Json
  /// Detected tags: GTM, GA4, Google Ads conversion, Meta Pixel, consent.
  tracking    Json?
  /// Broken links found and external links that leak the visitor away.
  links       Json?

  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  request   CrmAdRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)
  createdBy CrmUser       @relation(fields: [createdById], references: [id])

  @@index([requestId, createdAt])
  @@map("crm_landing_scores")
}

model CrmNotification {
  id        String              @id @default(cuid())
  userId    String              @map("user_id")
  type      CrmNotificationType
  title     String
  body      String
  /// Where clicking the notification takes the user.
  link      String?
  requestId String?             @map("request_id")
  readAt    DateTime?           @map("read_at")
  createdAt DateTime            @default(now()) @map("created_at")

  user    CrmUser       @relation(fields: [userId], references: [id], onDelete: Cascade)
  request CrmAdRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("crm_notifications")
}

model CrmAuditLog {
  id          String         @id @default(cuid())
  actorId     String?        @map("actor_id")
  /// Denormalised so the trail survives the user being deleted.
  actorEmail  String?        @map("actor_email")
  action      CrmAuditAction
  targetType  String?        @map("target_type")
  targetId    String?        @map("target_id")
  description String
  /// Before/after values for permission and role changes.
  metadata    Json?
  ipAddress   String?        @map("ip_address")
  createdAt   DateTime       @default(now()) @map("created_at")

  actor CrmUser? @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@map("crm_audit_logs")
}
