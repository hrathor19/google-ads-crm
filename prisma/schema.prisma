generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model account_budgets {
  account_id   Int
  period       String   @db.VarChar(8)
  period_start DateTime @db.Date
  amount       Decimal  @db.Decimal(16, 2)
  set_by       String?  @db.VarChar(160)
  id           Int      @id(map: "pk_account_budgets") @default(autoincrement())
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @db.Timestamptz(6)
  accounts     accounts @relation(fields: [account_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_account_budgets_account_id_accounts")

  @@unique([account_id, period, period_start], map: "account_budget_uq")
  @@index([account_id], map: "ix_account_budgets_account_id")
  @@index([period_start], map: "ix_account_budgets_period_start")
}

model account_weekly_budgets {
  account_id Int
  week_start DateTime @db.Date
  amount     Decimal  @db.Decimal(14, 2)
  set_by     String?  @db.VarChar(160)
  id         Int      @id(map: "pk_account_weekly_budgets") @default(autoincrement())
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  accounts   accounts @relation(fields: [account_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_account_weekly_budgets_account_id_accounts")

  @@unique([account_id, week_start], map: "account_weekly_budget_uq")
  @@index([account_id], map: "ix_account_weekly_budgets_account_id")
  @@index([week_start], map: "ix_account_weekly_budgets_week_start")
}

model accounts {
  customer_id               String                      @unique(map: "ix_accounts_customer_id") @db.VarChar(20)
  descriptive_name          String?                     @db.VarChar(255)
  currency_code             String?                     @db.VarChar(8)
  time_zone                 String?                     @db.VarChar(64)
  status                    String?                     @db.VarChar(32)
  is_manager                Boolean
  manager_customer_id       String?                     @db.VarChar(20)
  test_account              Boolean?
  auto_tagging_enabled      Boolean?
  is_syncable               Boolean
  id                        Int                         @id(map: "pk_accounts") @default(autoincrement())
  created_at                DateTime                    @default(now()) @db.Timestamptz(6)
  updated_at                DateTime                    @default(now()) @db.Timestamptz(6)
  account_budgets           account_budgets[]
  account_weekly_budgets    account_weekly_budgets[]
  ad_copy_generations       ad_copy_generations[]
  ad_group_snapshots        ad_group_snapshots[]
  ad_groups                 ad_groups[]
  ad_snapshots              ad_snapshots[]
  ads                       ads[]
  alerts                    alerts[]
  api_tokens                api_tokens[]
  budget_snapshots          budget_snapshots[]
  budgets                   budgets[]
  campaign_device_snapshots campaign_device_snapshots[]
  campaign_geo_snapshots    campaign_geo_snapshots[]
  campaign_snapshots        campaign_snapshots[]
  campaigns                 campaigns[]
  keyword_snapshots         keyword_snapshots[]
  keywords                  keywords[]
  recommendations           recommendations[]
  scorecard_snapshots       scorecard_snapshots[]
  search_term_snapshots     search_term_snapshots[]
  search_terms              search_terms[]
  user_accounts             user_accounts[]
  CrmRoleAccount            CrmRoleAccount[]
  CrmUserAccount            CrmUserAccount[]
  CrmAdRequest              CrmAdRequest[]

  @@index([manager_customer_id], map: "ix_accounts_manager_customer_id")
}

model ad_copy_generations {
  actor                                              String?               @db.VarChar(320)
  campus                                             String                @db.VarChar(255)
  account_id                                         Int?
  campaign_id                                        Int?
  final_url                                          String?
  url_source                                         String?               @db.VarChar(48)
  url_confidence                                     Decimal?              @db.Decimal(5, 4)
  backend                                            String?               @db.VarChar(16)
  historical_features_used                           Json?
  keyword_snapshot                                   Json?
  keyword_edits                                      Json?
  generated_assets                                   Json?
  scores                                             Json?
  reasoning                                          Json?
  approval_status                                    String                @db.VarChar(16)
  submitted_at                                       DateTime?             @db.Timestamp(6)
  reviewed_at                                        DateTime?             @db.Timestamp(6)
  reviewer_name                                      String?               @db.VarChar(160)
  review_note                                        String?
  overrides                                          Json?
  approval_token                                     String?               @db.VarChar(64)
  ad_manager                                         String?               @db.VarChar(160)
  owner_user_id                                      Int?
  submitter_user_id                                  Int?
  id                                                 Int                   @id(map: "pk_ad_copy_generations") @default(autoincrement())
  created_at                                         DateTime              @default(now()) @db.Timestamptz(6)
  updated_at                                         DateTime              @default(now()) @db.Timestamptz(6)
  accounts                                           accounts?             @relation(fields: [account_id], references: [id], onUpdate: NoAction, map: "fk_ad_copy_generations_account_id_accounts")
  campaigns                                          campaigns?            @relation(fields: [campaign_id], references: [id], onUpdate: NoAction, map: "fk_ad_copy_generations_campaign_id_campaigns")
  users_ad_copy_generations_owner_user_idTousers     users?                @relation("ad_copy_generations_owner_user_idTousers", fields: [owner_user_id], references: [id], onUpdate: NoAction, map: "fk_ad_copy_generations_owner_user_id_users")
  users_ad_copy_generations_submitter_user_idTousers users?                @relation("ad_copy_generations_submitter_user_idTousers", fields: [submitter_user_id], references: [id], onUpdate: NoAction, map: "fk_ad_copy_generations_submitter_user_id_users")
  approval_events                                    approval_events[]
  scorecard_snapshots                                scorecard_snapshots[]

  @@index([account_id, created_at], map: "ix_ad_copy_generations_account_created")
  @@index([account_id], map: "ix_ad_copy_generations_account_id")
  @@index([actor], map: "ix_ad_copy_generations_actor")
  @@index([ad_manager], map: "ix_ad_copy_generations_ad_manager")
  @@index([approval_status], map: "ix_ad_copy_generations_approval_status")
  @@index([approval_token], map: "ix_ad_copy_generations_approval_token")
  @@index([campaign_id], map: "ix_ad_copy_generations_campaign_id")
  @@index([campus], map: "ix_ad_copy_generations_campus")
  @@index([campus, created_at], map: "ix_ad_copy_generations_campus_created")
  @@index([owner_user_id], map: "ix_ad_copy_generations_owner_user_id")
  @@index([submitter_user_id], map: "ix_ad_copy_generations_submitter_user_id")
}

model ad_group_snapshots {
  ad_group_id        Int
  campaign_id        Int
  status             String?    @db.VarChar(32)
  cpc_bid_micros     BigInt?
  id                 Int        @id(map: "pk_ad_group_snapshots") @default(autoincrement())
  snapshot_date      DateTime   @db.Date
  sync_time          DateTime   @default(now()) @db.Timestamptz(6)
  account_id         Int
  sync_log_id        Int?
  impressions        BigInt
  clicks             BigInt
  interactions       BigInt
  cost_micros        BigInt
  ctr                Decimal?   @db.Decimal(12, 6)
  average_cpc_micros BigInt?
  average_cpm_micros BigInt?
  conversions        Decimal    @db.Decimal(16, 4)
  conversions_value  Decimal    @db.Decimal(18, 4)
  all_conversions    Decimal    @db.Decimal(16, 4)
  video_views        BigInt
  accounts           accounts   @relation(fields: [account_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ad_group_snapshots_account_id_accounts")
  ad_groups          ad_groups  @relation(fields: [ad_group_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ad_group_snapshots_ad_group_id_ad_groups")
  campaigns          campaigns  @relation(fields: [campaign_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ad_group_snapshots_campaign_id_campaigns")
  sync_logs          sync_logs? @relation(fields: [sync_log_id], references: [id], onUpdate: NoAction, map: "fk_ad_group_snapshots_sync_log_id_sync_logs")

  @@index([account_id], map: "ix_ad_group_snapshots_account_id")
  @@index([ad_group_id], map: "ix_ad_group_snapshots_ad_group_id")
  @@index([campaign_id], map: "ix_ad_group_snapshots_campaign_id")
  @@index([snapshot_date], map: "ix_ad_group_snapshots_snapshot_date")
  @@index([sync_time], map: "ix_ad_group_snapshots_sync_time")
}

model ad_groups {
  account_id            Int
  campaign_id           Int
  ad_group_id           BigInt
  name                  String?                 @db.VarChar(512)
  status                String?                 @db.VarChar(32)
  type                  String?                 @db.VarChar(64)
  cpc_bid_micros        BigInt?
  id                    Int                     @id(map: "pk_ad_groups") @default(autoincrement())
  created_at            DateTime                @default(now()) @db.Timestamptz(6)
  updated_at            DateTime                @default(now()) @db.Timestamptz(6)
  ad_group_snapshots    ad_group_snapshots[]
  accounts              accounts                @relation(fields: [account_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ad_groups_account_id_accounts")
  campaigns             campaigns               @relation(fields: [campaign_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ad_groups_campaign_id_campaigns")
  ad_snapshots          ad_snapshots[]
  ads                   ads[]
  keyword_snapshots     keyword_snapshots[]
  keywords              keywords[]
  search_term_snapshots search_term_snapshots[]
  search_terms          search_terms[]

  @@unique([campaign_id, ad_group_id], map: "ad_groups_campaign_adgroup")
  @@index([account_id], map: "ix_ad_groups_account_id")
  @@index([ad_group_id], map: "ix_ad_groups_ad_group_id")
  @@index([campaign_id], map: "ix_ad_groups_campaign_id")
}

model ad_snapshots {
  ad_id              Int
  ad_group_id        Int
  campaign_id        Int
  status             String?    @db.VarChar(32)
  approval_status    String?    @db.VarChar(32)
  id                 Int        @id(map: "pk_ad_snapshots") @default(autoincrement())
  snapshot_date      DateTime   @db.Date
  sync_time          DateTime   @default(now()) @db.Timestamptz(6)
  account_id         Int
  sync_log_id        Int?
  impressions        BigInt
  clicks             BigInt
  interactions       BigInt
  cost_micros        BigInt
  ctr                Decimal?   @db.Decimal(12, 6)
  average_cpc_micros BigInt?
  average_cpm_micros BigInt?
  conversions        Decimal    @db.Decimal(16, 4)
  conversions_value  Decimal    @db.Decimal(18, 4)
  all_conversions    Decimal    @db.Decimal(16, 4)
  video_views        BigInt
  accounts           accounts   @relation(fields: [account_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ad_snapshots_account_id_accounts")
  ad_groups          ad_groups  @relation(fields: [ad_group_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ad_snapshots_ad_group_id_ad_groups")
  ads                ads        @relation(fields: [ad_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ad_snapshots_ad_id_ads")
  campaigns          campaigns  @relation(fields: [campaign_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ad_snapshots_campaign_id_campaigns")
  sync_logs          sync_logs? @relation(fields: [sync_log_id], references: [id], onUpdate: NoAction, map: "fk_ad_snapshots_sync_log_id_sync_logs")

  @@index([account_id, snapshot_date], map: "ix_ad_snapshots_account_date")
  @@index([account_id], map: "ix_ad_snapshots_account_id")
  @@index([ad_group_id], map: "ix_ad_snapshots_ad_group_id")
  @@index([ad_id], map: "ix_ad_snapshots_ad_id")
  @@index([campaign_id], map: "ix_ad_snapshots_campaign_id")
  @@index([snapshot_date], map: "ix_ad_snapshots_snapshot_date")
  @@index([sync_time], map: "ix_ad_snapshots_sync_time")
}

model ads {
  account_id      Int
  ad_group_id     Int
  ad_id           BigInt
  type            String?        @db.VarChar(64)
  status          String?        @db.VarChar(32)
  approval_status String?        @db.VarChar(32)
  final_urls      String?
  headlines       String?
  descriptions    String?
  id              Int            @id(map: "pk_ads") @default(autoincrement())
  created_at      DateTime       @default(now()) @db.Timestamptz(6)
  updated_at      DateTime       @default(now()) @db.Timestamptz(6)
  ad_snapshots    ad_snapshots[]
  accounts        accounts       @relation(fields: [account_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ads_account_id_accounts")
  ad_groups       ad_groups      @relation(fields: [ad_group_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ads_ad_group_id_ad_groups")

  @@unique([ad_group_id, ad_id], map: "ads_adgroup_ad")
  @@index([account_id], map: "ix_ads_account_id")
  @@index([ad_group_id], map: "ix_ads_ad_group_id")
  @@index([ad_id], map: "ix_ads_ad_id")
}

model alembic_version {
  version_num String @id(map: "alembic_version_pkc") @db.VarChar(32)
}

model alerts {
  account_id       Int?
  entity_type      String    @db.VarChar(32)
  entity_id        Int?
  entity_name      String?   @db.VarChar(512)
  alert_type       String    @db.VarChar(48)
  severity         String    @db.VarChar(16)
  status           String    @db.VarChar(16)
  title            String    @db.VarChar(255)
  description      String?
  suggested_action String?
  metric_value     Decimal?  @db.Decimal(18, 4)
  threshold_value  Decimal?  @db.Decimal(18, 4)
  dedupe_key       String    @unique(map: "ix_alerts_dedupe_key") @db.VarChar(255)
  first_seen_at    DateTime  @default(now()) @db.Timestamptz(6)
  last_seen_at     DateTime  @default(now()) @db.Timestamptz(6)
  resolved_at      DateTime? @db.Timestamptz(6)
  details          Json?
  id               Int       @id(map: "pk_alerts") @default(autoincrement())
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  updated_at       DateTime  @default(now()) @db.Timestamptz(6)
  accounts         accounts? @relation(fields: [account_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_alerts_account_id_accounts")

  @@index([account_id], map: "ix_alerts_account_id")
  @@index([alert_type], map: "ix_alerts_alert_type")
  @@index([entity_id], map: "ix_alerts_entity_id")
  @@index([entity_type], map: "ix_alerts_entity_type")
  @@index([severity], map: "ix_alerts_severity")
  @@index([status], map: "ix_alerts_status")
}

model api_tokens {
  provider                String    @db.VarChar(32)
  account_id              Int?
  client_id               String?   @db.VarChar(255)
  refresh_token_encrypted String?
  scopes                  String?
  expires_at              DateTime? @db.Timestamptz(6)
  is_active               Boolean
  id                      Int       @id(map: "pk_api_tokens") @default(autoincrement())
  created_at              DateTime  @default(now()) @db.Timestamptz(6)
  updated_at              DateTime  @default(now()) @db.Timestamptz(6)
  accounts                accounts? @relation(fields: [account_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_api_tokens_account_id_accounts")

  @@index([account_id], map: "ix_api_tokens_account_id")
  @@index([provider], map: "ix_api_tokens_provider")
}

model approval_events {
  generation_id       Int
  event               String              @db.VarChar(24)
  actor               String?             @db.VarChar(160)
  note                String?
  id                  Int                 @id(map: "pk_approval_events") @default(autoincrement())
  created_at          DateTime            @default(now()) @db.Timestamptz(6)
  updated_at          DateTime            @default(now()) @db.Timestamptz(6)
  ad_copy_generations ad_copy_generations @relation(fields: [generation_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_approval_events_generation_id_ad_copy_generations")

  @@index([generation_id], map: "ix_approval_events_generation_id")
}

model audit_logs {
  actor       String?  @db.VarChar(320)
  role        String?  @db.VarChar(32)
  method      String   @db.VarChar(8)
  path        String   @db.VarChar(512)
  status_code Int?
  duration_ms Int?
  client_ip   String?  @db.VarChar(64)
  detail      String?
  id          Int      @id(map: "pk_audit_logs") @default(autoincrement())
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @db.Timestamptz(6)

  @@index([actor], map: "ix_audit_logs_actor")
  @@index([path], map: "ix_audit_logs_path")
}

model budget_snapshots {
  budget_id       Int
  amount_micros   BigInt?
  spend_micros    BigInt?
  utilization     Decimal?   @db.Decimal(10, 4)
  delivery_method String?    @db.VarChar(32)
  id              Int        @id(map: "pk_budget_snapshots") @default(autoincrement())
  snapshot_date   DateTime   @db.Date
  sync_time       DateTime   @default(now()) @db.Timestamptz(6)
  account_id      Int
  sync_log_id     Int?
  accounts        accounts   @relation(fields: [account_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_budget_snapshots_account_id_accounts")
  budgets         budgets    @relation(fields: [budget_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_budget_snapshots_budget_id_budgets")
  sync_logs       sync_logs? @relation(fields: [sync_log_id], references: [id], onUpdate: NoAction, map: "fk_budget_snapshots_sync_log_id_sync_logs")

  @@index([account_id], map: "ix_budget_snapshots_account_id")
  @@index([budget_id, snapshot_date], map: "ix_budget_snapshots_budget_date")
  @@index([budget_id], map: "ix_budget_snapshots_budget_id")
  @@index([snapshot_date], map: "ix_budget_snapshots_snapshot_date")
  @@index([sync_time], map: "ix_budget_snapshots_sync_time")
}

model budgets {
  account_id        Int
  budget_id         BigInt
  name              String?            @db.VarChar(512)
  amount_micros     BigInt?
  delivery_method   String?            @db.VarChar(32)
  period            String?            @db.VarChar(32)
  explicitly_shared Boolean?
  id                Int                @id(map: "pk_budgets") @default(autoincrement())
  created_at        DateTime           @default(now()) @db.Timestamptz(6)
  updated_at        DateTime           @default(now()) @db.Timestamptz(6)
  budget_snapshots  budget_snapshots[]
  accounts          accounts           @relation(fields: [account_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_budgets_account_id_accounts")

  @@unique([account_id, budget_id], map: "budgets_account_budget")
  @@index([account_id], map: "ix_budgets_account_id")
  @@index([budget_id], map: "ix_budgets_budget_id")
}

